# Database (SQLite default for local hackathon demo; switch to PostgreSQL URL for production)
DATABASE_URL="file:./dev.db"

# Session signing secret (replace in production)
SESSION_SECRET="replace-with-strong-random-secret"

# AI Orchestrator Configuration (supports "auto", "gemini", or "deterministic")
# Leave GEMINI_API_KEY empty to run Stratium's local deterministic tool-execution engine.
LLM_PROVIDER="auto"
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.6-flash"

# PayPal Developer Sandbox Configuration (NEVER commit live credentials)
PAYPAL_ENV="sandbox"
PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""
PAYPAL_WEBHOOK_ID=""
PAYPAL_ENABLE_PAYOUTS="false"

# Application URL (used for PayPal return/cancel redirect URLs)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

